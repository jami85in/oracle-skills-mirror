webCredential fusion-ai-console-oci-cred (
    name: Fusion Console - OCI Native Credential
    type: oci
    authentication {
        ociUserId: PENDING-OCI-USER-OCID
        ociTenancyId: PENDING-OCI-TENANCY-OCID
        ociPublicKeyFingerprint: PENDING-OCI-KEY-FINGERPRINT
    }
    advanced {
        staticId: fusion-ai-console-oci-cred
        promptOnInstall: true
    }
    comments {
        comments:
            ```
            Backs calls to OCI Generative AI (and, in Phase 4, OCI
            Generative AI Agents) via APEX_WEB_SERVICE's OCI native request
            signing. ociUserId/ociTenancyId/ociPublicKeyFingerprint above
            are placeholders - replace with the real OCIDs/fingerprint.
            promptOnInstall:true means the RSA private key itself is
            supplied through the Web Credential wizard at import time, not
            stored in this source file - never commit that key.
            ```
    }
)
