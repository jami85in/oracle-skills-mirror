            "description": "Matches the extracted ledger name against the fetched ledger LOV to find the real ledger id."
          },
          "outcomes": {
            "success": "12"
          },
          "inputs": [
            {
              "id": "16_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Find the ledger whose name matches \"{{$context.$nodes.EXTRACT_REQUEST_DETAILS.$output.ledgerName}}\" (case-insensitive, allow minor wording differences) in this ledger list: {{$context.$nodes.RESOLVE_LEDGER_ID.$output}}. Return the matching ledger's numeric id as ledgerId and set matched to true. If no reasonable match exists, set matched to false and leave ledgerId empty."
            }
          ],
