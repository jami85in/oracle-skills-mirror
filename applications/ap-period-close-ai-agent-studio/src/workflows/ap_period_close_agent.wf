        {
          "id": "20",
          "code": "BUILD_HOLDS_QUERY",
          "type": "CODE",
          "metadata": {
            "name": "Build Holds Query",
            "description": "Pre-builds the invoiceHolds q filter string from the extracted date range.",
            "sourceCode": "const startDate = $context.$nodes.EXTRACT_REQUEST_DETAILS?.$output?.startDate || \"\";\nconst endDate = $context.$nodes.EXTRACT_REQUEST_DETAILS?.$output?.endDate || \"\";\nconst q = \"HoldDate>='\" + startDate + \"';HoldDate<='\" + endDate + \"'\";\nconst result = { q };\nreturn result;",
            "returnType": "object"
          },
          "outcomes": {
            "success": "10"
          },
          "inputs": [],
          "diagram": {
            "x": 5000,
            "y": 5872
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-04/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"result\": {\n      \"type\": \"object\"\n    },\n    \"timeout\": {\n      \"type\": \"boolean\"\n    },\n    \"error\": {\n      \"type\": \"string\"\n    }\n  },\n  \"additionalProperties\": false,\n  \"required\": [\n    \"result\",\n    \"timeout\",\n    \"error\"\n  ]\n}"
        },
        {
          "id": "10",
          "code": "QUERY_OPEN_HOLDS",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Query Open Holds",
            "description": "Searches AP invoice holds by hold date range via the existing holds BO; open/released is determined downstream from ReleaseDate.",
            "businessObjectCode": "LN_AP_INVOICE_HOLDS_BO",
            "functionName": "search_invoiceHolds"
          },
          "outcomes": {
            "success": "4"
          },
          "inputs": [
            {
              "id": "10_q",
              "name": "q",
              "type": "string",
              "value": "{{$context.$nodes.BUILD_HOLDS_QUERY.$output.result.q}}"
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 6094
          },
          "outputSpecification": "{\n  \"$schema\": \"http://json-schema.org/draft-07/schema#\",\n  \"type\": \"object\",\n  \"properties\": {\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"HoldId\": {\n            \"type\": \"number\"\n          },\n          \"InvoiceNumber\": {\n            \"type\": \"string\"\n          },\n          \"BusinessUnit\": {\n            \"type\": \"string\"\n          },\n          \"Supplier\": {\n            \"type\": \"string\"\n          },\n          \"LineHeld\": {\n            \"type\": \"null\"\n          },\n          \"HoldDate\": {\n            \"type\": \"string\"\n          },\n          \"HoldDetails\": {\n            \"type\": \"null\"\n          },\n          \"HoldReason\": {\n            \"type\": \"string\"\n          },\n          \"ReleaseReason\": {\n            \"type\": \"null\"\n          },\n          \"WorkflowStatus\": {\n            \"type\": \"null\"\n          },\n          \"ReleaseName\": {\n            \"type\": \"null\"\n          },\n          \"HoldName\": {\n            \"type\": \"string\"\n          },\n          \"ReleaseDate\": {\n            \"type\": \"null\"\n          },\n          \"HeldBy\": {\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"HoldId\",\n          \"InvoiceNumber\",\n          \"BusinessUnit\",\n          \"Supplier\",\n          \"LineHeld\",\n          \"HoldDate\",\n          \"HoldDetails\",\n          \"HoldReason\",\n          \"ReleaseReason\",\n          \"WorkflowStatus\",\n          \"ReleaseName\",\n          \"HoldName\",\n          \"ReleaseDate\",\n          \"HeldBy\"\n        ],\n        \"additionalProperties\": false\n      }\n    },\n    \"totalResults\": {\n      \"type\": \"number\"\n    },\n    \"count\": {\n      \"type\": \"number\"\n    },\n    \"hasMore\": {\n      \"type\": \"boolean\"\n    },\n    \"limit\": {\n      \"type\": \"number\"\n    },\n    \"offset\": {\n      \"type\": \"number\"\n    }\n  },\n  \"required\": [\n    \"items\",\n    \"totalResults\",\n    \"count\",\n    \"hasMore\",\n    \"limit\",\n    \"offset\"\n  ],\n  \"additionalProperties\": false\n}"
        },
        {
          "id": "4",
          "code": "SUMMARIZE_EXCEPTIONS_AND_ASK",
          "type": "LLM",
          "metadata": {
            "name": "Summarize Exceptions And Ask",
            "description": "Summarizes stuck invoices/holds and asks the user how to proceed."
          },
          "outcomes": {
            "success": "7"
          },
          "inputs": [
            {
              "id": "4_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Using this unaccounted/needs-validation invoices data: {{$context.$nodes.QUERY_UNACCOUNTED_INVOICES.$output}} and this invoice-holds data: {{$context.$nodes.QUERY_OPEN_HOLDS.$output}}, summarize any stuck AP invoices or open holds for the period (count, total amount if available, and why each is stuck). For the holds data, a hold is still active only when its ReleaseDate field is null or missing - ignore any row where ReleaseDate is populated, since that hold has already been released. If nothing stuck remains after that check, say the period looks clear. Then explicitly ask the user whether the stuck items should be swept to the next period or handled another way, or, if nothing is stuck, ask the user to confirm proceeding with opening the next period, running Create Accounting, and closing the current period. Keep the message concise and end with one clear question."
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 6316
          }
        },
        {
          "id": "7",
          "code": "ASK_ABOUT_SWEEP",
          "type": "HUMAN",
          "metadata": {
            "name": "Ask About Sweep",
            "description": "Displays the exceptions summary/question and waits for the user's reply; loops back to the classifier.",
            "channelType": "CHAT",
            "approvalEnabledFlag": false,
            "feedbackEnabledFlag": true,
            "loopBackNodeId": "5"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "7_chatChannelInput",
              "name": "chatChannelInput",
              "type": "object",
              "value": {
                "messageTemplate": {
                  "message": "{{$context.$nodes.SUMMARIZE_EXCEPTIONS_AND_ASK.$output}}"
                }
              }
            }
          ],
          "diagram": {
            "x": 5000,
            "y": 6538
          }
        },
        {
          "id": "5",
          "code": "CLASSIFY_SWEEP_DECISION",
          "type": "LLM",
          "metadata": {
            "name": "Classify Sweep Decision",
            "description": "Classifies the user's reply as PROCEED or STOP."
          },
          "outcomes": {
            "success": "8"
          },
          "inputs": [
            {
              "id": "5_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Classify the user's reply to a question about sweeping stuck AP invoices/holds to the next period, or about proceeding with period close when no exceptions were found. Reply text: {{$context.$nodes.ASK_ABOUT_SWEEP.$feedbackReceived}}. If the user wants to proceed with the sweep and continue closing the period, or confirms proceeding when there were no exceptions, set decision to PROCEED. If the user wants to stop, wait, or handle it another way, set decision to STOP."
            }
          ],
          "diagram": {
            "x": 5850,
            "y": 5000
          },
          "outputSpecification": "{\"type\":\"object\",\"properties\":{\"decision\":{\"type\":\"string\",\"enum\":[\"PROCEED\",\"STOP\"]}}}\n"
        },
        {
          "id": "8",
          "code": "ROUTE_SWEEP_DECISION",
          "type": "SWITCH",
          "metadata": {
            "name": "Route Sweep Decision",
            "description": "Routes to PROCEED or STOP based on the classified reply.",
            "convergenceTargetId": "6"
          },
          "outcomes": {
            "STOP": "6",
            "PROCEED": "11",
            "success": ""
          },
          "inputs": [
            {
              "id": "8_caseExpression",
              "name": "caseExpression",
              "type": "string",
              "value": "{{$context.$nodes.CLASSIFY_SWEEP_DECISION.$output.decision}}"
            }
          ],
          "diagram": {
            "x": 5850,
            "y": 5222
          },
          "convergenceTargetId": "6"
        },
        {
          "id": "6",
          "code": "FINAL_RESPONSE",
          "type": "LLM",
          "metadata": {
            "name": "Final Response",
            "description": "Convergence terminal: reports outcome whether stopped or proceeded."
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "6_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Generate a final status message for the user about this AP period close request. Check {{$context.$nodes.CLASSIFY_SWEEP_DECISION.$output.decision}}. If it is STOP, acknowledge that no further action was taken and invite the user to say how they'd like to proceed with the stuck invoices or holds. If it is PROCEED, summarize that the next period was opened, Create Accounting was submitted for Payables, and the current period was closed, using these submission results: period open result {{$context.$nodes.SUBMIT_PERIOD_OPEN.$output}}, create accounting result {{$context.$nodes.SUBMIT_CREATE_ACCOUNTING.$output}}, period close result {{$context.$nodes.SUBMIT_PERIOD_CLOSE.$output}}. Tell the user these actions were submitted directly with no separate approval step. Return only the final message text."
            }
          ],
          "diagram": {
            "x": 5850,
            "y": 6554
          }
        },
