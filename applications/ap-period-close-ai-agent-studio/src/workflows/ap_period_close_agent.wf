{
  "workflowId": "300000142045074",
  "workflowCode": "AP_PERIOD_CLOSE_AGENT",
  "name": "AP Period Close Agent",
  "description": "Checks AP invoices/holds that could block period close, asks the user how to handle any found, then opens the next period, runs Create Accounting, and closes the current period.",
  "specification": {
    "jsonSchemaName": "Workflow.spec",
    "jsonSchemaVersion": "1",
    "inputs": [],
    "outputSpecification": " ",
    "agentsValueMappings": [],
    "dataPipeline": {
      "pipelineNodes": [
        {
          "id": "start",
          "code": "START",
          "type": "START",
          "metadata": {
            "name": "Start",
            "description": "Start of data pipeline"
          },
          "outcomes": {
            "success": "1"
          },
          "inputs": [],
          "diagram": {
            "x": 5225,
            "y": 5000
          }
        },
        {
          "id": "1",
          "code": "EXTRACT_REQUEST_DETAILS",
          "type": "LLM",
          "metadata": {
            "name": "Extract Request Details",
            "description": "Extracts ledger, period, next period, and estimated period date range from the user's message."
          },
          "outcomes": {
            "success": "19"
          },
          "inputs": [
            {
              "id": "1_systemPrompt",
              "name": "systemPrompt",
              "type": "string",
              "value": "You extract structured period-close request details for an Accounts Payable period-close agent. Always return ledgerName, periodName, nextPeriodName, startDate, and endDate."
            },
            {
              "id": "1_prompt",
              "name": "prompt",
              "type": "string",
              "value": "Extract the ledger name and accounting period being referenced for an AP period close request from this message: {{$context.$system.$inputMessage}}. If this message does not clearly state the ledger and/or period, but a prior clarification reply is available, use it instead or in addition: {{$context.$nodes.ASK_LEDGER_PERIOD.$feedbackReceived}}. Also compute the next calendar period name in the same MON-YY style, and estimate the ISO start date and end date (YYYY-MM-DD) of the referenced period's calendar month. Return only the structured fields requested. If ledger or period still cannot be determined, return empty strings for the unknown fields rather than guessing."
            }
          ],
          "diagram": {
            "x": 5225,
            "y": 5206
          },
          "outputSpecification": "{\"type\":\"object\",\"properties\":{\"ledgerName\":{\"type\":\"string\"},\"periodName\":{\"type\":\"string\"},\"nextPeriodName\":{\"type\":\"string\"},\"startDate\":{\"type\":\"string\"},\"endDate\":{\"type\":\"string\"}}}\n"
        },
        {
          "id": "19",
          "code": "CHECK_LEDGER_PERIOD_PROVIDED",
          "type": "CONDITION",
          "metadata": {
            "name": "Check Ledger Period Provided",
            "description": "Branches to ask for ledger/period when the initial message did not include them."
          },
          "outcomes": {
            "false": "18",
            "true": "9"
          },
          "inputs": [
            {
              "id": "19_condition",
              "name": "condition",
              "type": "string",
              "value": "{{!!$context.$nodes.EXTRACT_REQUEST_DETAILS.$output.ledgerName && !!$context.$nodes.EXTRACT_REQUEST_DETAILS.$output.periodName}}"
            }
          ],
          "diagram": {
            "x": 5225,
            "y": 5428
          },
          "convergenceTargetId": "end"
        },
        {
          "id": "18",
          "code": "ASK_LEDGER_PERIOD",
          "type": "HUMAN",
          "metadata": {
            "name": "Ask Ledger Period",
            "description": "Asks the user for ledger and period when not stated upfront; loops back to the extractor.",
            "channelType": "CHAT",
            "approvalEnabledFlag": false,
            "feedbackEnabledFlag": true,
            "loopBackNodeId": "1"
          },
          "outcomes": {
            "success": "end"
          },
          "inputs": [
            {
              "id": "18_chatChannelInput",
              "name": "chatChannelInput",
              "type": "object",
              "value": {
                "messageTemplate": {
                  "message": "Which ledger and accounting period would you like to close? For example: Vision Operations, AUG-25."
                }
              }
            }
          ],
          "diagram": {
            "x": 5450,
            "y": 5650
          }
        },
        {
          "id": "9",
          "code": "QUERY_UNACCOUNTED_INVOICES",
          "type": "BO_FUNCTION",
          "metadata": {
            "name": "Query Unaccounted Invoices",
            "description": "Fetches Payables invoices in Unaccounted/Needs Validation status via the existing exception-report BO.",
            "businessObjectCode": "ORA_FIN_PAYABLES_PAYABLESPERIODCLOSEEXCEPTIONREPORT",
            "functionName": "getall_invoices"
          },
          "outcomes": {
            "success": "20"
          },
