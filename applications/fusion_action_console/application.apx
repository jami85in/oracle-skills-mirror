app FUSION-ACTION-CONSOLE (
    name: Fusion Action Console
    logo {
        type: text
        text: &APP_TITLE.
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            js-defaultCollapsed
            js-navCollapsed--hidden
            t-TreeNav--styleA
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DS
        timestamp: DS
        timestampTimeZone: DS
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    authorization {
        sourceForRoleOrGroupSchemes: authenticationScheme
    }
    sessionManagement {
        maxSessionIdleTime: 3600
        maxSessionLength: 28800
    }
    sessionStateProtection {
        checksumSalt: DA8E179258E27A11AF6CB1AE9D5F877AE27F7AB1E593AC34CB8929C77E5AECAA
    }
    runtime {
        allowFeedback: true
        compatibilityMode: 26.1
    }
)
