    installScript fac-conn-get-pkg-spec (
        name: FAC_CONN_GET_PKG spec
        execution {
            sequence: 110
        }
        script {
            type: packageSpec
            content:
                ```sql
                CREATE OR REPLACE PACKAGE fac_conn_get_pkg AUTHID DEFINER AS
                    /* GET-only HTTP helper for outbound Fusion/OCI calls. Cannot issue
                       a non-GET request - there is no parameter or entry point for a
                       method or a request body, by design. Safe to grant broadly. */
                    FUNCTION get_json (
                        p_url           IN VARCHAR2,
                        p_credential_id IN VARCHAR2
                    ) RETURN CLOB;
                END fac_conn_get_pkg;
                ```
        }
    )

