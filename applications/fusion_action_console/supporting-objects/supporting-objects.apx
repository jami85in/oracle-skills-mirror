            content:
                ```sql
                CREATE OR REPLACE PACKAGE fac_audit_pkg AUTHID DEFINER AS
                    /* Insert-only writer of FAC_APPROVAL and FAC_ACTION_EXECUTION_LOG -
                       the audit trail for "who approved this" and "what happened when
                       it was sent to Fusion". */
                    PROCEDURE record_approval (
                        p_proposed_action_id    IN NUMBER,
                        p_apex_task_id          IN VARCHAR2,
                        p_task_definition_name  IN VARCHAR2,
                        p_outcome               IN VARCHAR2,
