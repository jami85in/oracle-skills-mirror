page 1 (
    name: Home
    alias: HOME
    title: Home
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
    }

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region app-name (
        name: Home
        title: &APP_TITLE.
        type: staticContent
        layout {
            sequence: 20
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

    region modules (
        name: Modules
        type: staticContent
        layout {
            sequence: 30
            slot: BODY
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
    )

    button go-suspense-queue (
        buttonName: GO_SUSPENSE_QUEUE
        label: Suspense Accounting
        layout {
            sequence: 10
            region: @modules
            slot: BODY
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-exclamation-triangle
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 200
                clearCache: 200
            }
        }
    )

    button go-my-approvals (
        buttonName: GO_MY_APPROVALS
        label: My Approvals
        layout {
            sequence: 20
            region: @modules
            slot: BODY
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-clipboard-check-alt
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 100
                clearCache: 100
            }
        }
    )

    button go-ai-assistant (
        buttonName: GO_AI_ASSISTANT
        label: Ask the Console
        layout {
            sequence: 30
            region: @modules
            slot: BODY
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-chatbot
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 110
                clearCache: 110
            }
        }
    )

    button go-gl-period-dashboard (
        buttonName: GO_GL_PERIOD_DASHBOARD
        label: GL Period Close
        layout {
            sequence: 40
            region: @modules
            slot: BODY
        }
        appearance {
            buttonTemplate: @/text-with-icon
            templateOptions: [
                #DEFAULT#
                t-Button--iconLeft
            ]
            icon: fa-calendar-check-o
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 300
                clearCache: 300
            }
        }
    )

    comments {
        comments:
            ```
            Module directory / landing page. Simple button links rather
            than a cards region for v1 - swap for a themeTemplateComponent
            cards region later if a richer module gallery is wanted. Only
            links to pages actually built in this pass (100, 110, 200,
            300); add a card for each new Fusion module as it's added,
            per the extensibility pattern in the plan.
            ```
    }

)
